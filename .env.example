# BẮT BUỘC — pipeline gọi thẳng Messages API. Lấy key tại
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Bắt buộc nếu key gắn với identity (API báo 'anthropic-workspace-id is required').
# Lấy id trong URL console: /settings/workspaces/<workspace_id>
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Tuỳ chọn: đổi model mặc định
# CONTENT_AGENT_MODEL=claude-sonnet-5

# BẮT BUỘC cho mọi lần chạy thật — pipeline không ghi file local nữa, Notion là
# nơi lưu duy nhất. Thiếu một trong hai biến thì run bị chặn ngay từ đầu.
# 1. Tạo integration tại https://www.notion.so/my-integrations, copy token.
# 2. Mở database đích -> "..." -> Connections -> thêm integration đó.
# 3. NOTION_DATA_SOURCE_ID là *data source id*, KHÔNG phải id trong URL trang.
# NOTION_TOKEN=ntn_...
# NOTION_DATA_SOURCE_ID=7c1ec11e-241d-4ff1-a23f-e83874462c46

# Tuỳ chọn: chạy pipeline bằng Gemini thay cho Claude (chọn nền tảng ở web UI).
# Lấy key tại https://console.cloud.google.com/apis/credentials
# GEMINI_API_KEY=AQ. ...
# Tuỳ chọn: đổi model Gemini mặc định
# DEFAULT_GEMINI_MODEL=gemini-1.5-turbo

# Tuỳ chọn: chạy pipeline bằng OpenAI thay cho Claude (chọn nền tảng ở web UI).
# OPENAI_API_KEY=sk-...
# Tuỳ chọn: đổi model OpenAI mặc định
# DEFAULT_OPENAI_MODEL=gpt-4o